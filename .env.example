# ============================================================
# CareerForge AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# NEVER prefix secrets with NEXT_PUBLIC_
# ============================================================

# ---------- General ----------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ---------- Database (Server Only) ----------
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/careerforge

# ---------- AI Provider (Server Only) ----------
GEMINI_API_KEY=
EMBEDDING_API_KEY=

# ---------- Authentication (Server Only) ----------
AUTH_SECRET=

# ---------- Object Storage (Server Only) ----------
STORAGE_ENDPOINT=
STORAGE_BUCKET=careerforge-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------- Email (Server Only, Optional) ----------
EMAIL_PROVIDER_API_KEY=

# ---------- Monitoring (Server Only, Optional) ----------
SENTRY_DSN=

# ---------- Rate Limiting ----------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=20
MAX_UPLOAD_SIZE_MB=10
MAX_RESUME_PAGES=10
